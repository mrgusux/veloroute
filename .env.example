# LLMCycle Environment Configuration Example

# API Keys (Comma-separated for multiple keys / load balancing)
# OPENAI_API_KEYS=sk-key1,sk-key2
# GROQ_API_KEYS=gsk-key1
# ANTHROPIC_API_KEYS=sk-ant-key1
# GEMINI_API_KEYS=AIzaSy...

# Dashboard Settings
LLMCYCLE_UI_HOST=127.0.0.1
LLMCYCLE_UI_PORT=8000
# Optional admin credentials (defaults are admin / admin for local use).
# Set both explicitly before exposing the dashboard beyond localhost.
# LLMCYCLE_USER_ADMIN=your-admin-name
# LLMCYCLE_USER_ADMIN_PASSWORD=use-a-long-random-password
# Optional: comma-separated origins for a separately hosted frontend.
# Leave unset when using the dashboard served by LLMCycle itself.
# LLMCYCLE_CORS_ORIGINS=https://dashboard.example.com

# Require virtual API keys on /v1/* even before the first key is created.
# LLMCYCLE_REQUIRE_API_KEY=1

# Fix UTF-8 encoding in Windows PowerShell
PYTHONUTF8=1
